<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A0D">

    <LinearLayout
        android:id="@+id/screenAuth"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FoodRecipe AI"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="회원으로 로그인하고 나만의 레시피 추천 흐름을 시작하세요."
            android:textColor="#C7D0D7"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_overlay_panel"
            android:hint="이메일"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#88FFFFFF"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_overlay_panel"
            android:hint="비밀번호 6자 이상"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#88FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvAuthMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#FFFFD166"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Firebase 설정이 필요합니다."
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary_button"
            android:text="로그인"
            android:textAllCaps="false"
            android:textColor="#07120D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSignup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_secondary_button"
            android:text="회원가입"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/cameraLayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <com.mingi.foodrecipe.BoundingBoxOverlayView
            android:id="@+id/boundingBoxOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/screenStart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSignedInUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_panel"
            android:padding="14dp"
            android:text="로그인됨"
            android:textColor="#C7D0D7"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="FoodRecipe AI"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="카메라로 재료를 인식하고, 지금 가진 음식으로 만들 수 있는 레시피를 단계별로 추천합니다."
            android:textColor="#C7D0D7"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_overlay_panel"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="지원 재료: Egg, Onion, Potato, Tomato, carrot&#10;촬영 후 감지된 음식 리스트를 확인하고 레시피 5가지를 추천받습니다."
            android:textColor="#E9F0F4"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_primary_button"
            android:text="시작하기"
            android:textAllCaps="false"
            android:textColor="#07120D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_secondary_button"
            android:text="로그아웃"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/screenMode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="스캔 방식 선택"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_overlay_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="실시간 재료 인식"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="재료를 화면 중앙에 크게 비추면 앱이 음식 리스트를 만들고, Gemini가 그 리스트로 레시피 5가지를 추천합니다."
                android:textColor="#C7D0D7"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBeginScan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary_button"
                android:text="카메라 열기"
                android:textAllCaps="false"
                android:textColor="#07120D"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_secondary_button"
            android:text="처음으로"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTopStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FoodRecipe AI"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="음식을 카메라에 비춰주세요"
            android:textColor="#DDE7ECEF"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cardDetected"
        app:layout_constraintEnd_toEndOf="@id/cardDetected"
        app:layout_constraintStart_toStartOf="@id/cardDetected"
        tools:visibility="visible">

        <ProgressBar
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="#66E3A5" />

        <TextView
            android:id="@+id/tvLoadingStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="레시피 생성 중..." />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardDetected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_light_panel"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="인식된 음식 리스트"
            android:textColor="#111418"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetectedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#5F6B73"
            android:textSize="14sp"
            tools:text="Tomato 91%, Onion 77%" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRescan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="다시 스캔"
                android:textAllCaps="false"
                android:textColor="#FF182026" />

            <Button
                android:id="@+id/btnRecommend"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:background="@drawable/bg_primary_button"
                android:text="레시피 5가지 추천"
                android:textAllCaps="false"
                android:textColor="#07120D"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardRecipes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_light_panel"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:text="추천 레시피 5가지"
            android:textColor="#111418"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecipeContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="18dp"
            android:textColor="#667078"
            android:textSize="12sp"
            tools:text="음식 리스트: Tomato, Onion" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="390dp"
            android:nestedScrollingEnabled="true"
            tools:listitem="@layout/item_recipe" />

        <Button
            android:id="@+id/btnScanAgainFromRecipes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_secondary_button"
            android:text="다른 재료 스캔"
            android:textAllCaps="false"
            android:textColor="#FF182026" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/panelRecipeDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_light_panel"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <Button
                android:id="@+id/btnBackToRecipes"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_secondary_button"
                android:text="목록으로"
                android:textAllCaps="false"
                android:textColor="#FF182026" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#111418"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="토마토 달걀볶음" />

            <TextView
                android:id="@+id/tvDetailSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#5F6B73"
                android:textSize="15sp"
                tools:text="부드러운 달걀과 토마토 산미가 잘 어울리는 빠른 한 끼입니다." />

            <TextView
                android:id="@+id/tvDetailIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#1A2024"
                android:textSize="15sp"
                tools:text="재료&#10;토마토, 달걀, 양파" />

            <LinearLayout
                android:id="@+id/layoutSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvDetailTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_status_chip"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="#1A3B2C"
                android:textSize="14sp"
                tools:text="팁: 토마토는 오래 볶지 않아야 식감이 살아납니다." />

        </LinearLayout>

    </ScrollView>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFF6B6B"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="오류가 발생했습니다" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="음식을 카메라에 비춰주세요" />

</androidx.constraintlayout.widget.ConstraintLayout>
